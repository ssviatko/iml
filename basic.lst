F00:5097       FN_SCALL	equ	FN_SIZE+28	; D_CALLFR
F00:5098       FN_SSLIF	equ	FN_SIZE+32	; .b D_SLIF
F00:5099       FN_SAVE1	equ	FN_SIZE+36	; D_FORVAR..D_NAME (72-127)
F00:5100       FN_SAVE2	equ	FN_SAVE1+56	; D_SWVAL..D_FORSTEP (192-239)
