F00:5006       ; ---------------------------------------------------------------- DEF FN, DEF PROC
F00:5007       
F00:5008       ; an FN/PROC call's frame on the stack: the parameters (laid out like variables), then
F00:5009       ; what the call has to put back
F00:5010       FN_TYPE		equ	FN_SIZE+0	; .w 1 FN, 2 PROC
F00:5011       FN_MULTI	equ	FN_SIZE+2	; .w a multi-line body
F00:5012       FN_LINE		equ	FN_SIZE+4	; the DEF's line
F00:5013       FN_SCURL	equ	FN_SIZE+8	; saved: D_CURLIN
F00:5014       FN_SSTMT	equ	FN_SIZE+12	; D_STMT
F00:5015       FN_SSP		equ	FN_SIZE+16	; D_STMTSP
F00:5016       FN_STMPB	equ	FN_SIZE+20	; D_TMPBASE
F00:5017       FN_SGCF		equ	FN_SIZE+24	; D_GCFLOOR
F00:5018       FN_SCALL	equ	FN_SIZE+28	; D_CALLFR
F00:5019       FN_SSLIF	equ	FN_SIZE+32	; .b D_SLIF
F00:5020       FN_SAVE1	equ	FN_SIZE+36	; D_FORVAR..D_NAME (72-127)
F00:5021       FN_SAVE2	equ	FN_SAVE1+56	; D_SWVAL..D_FORSTEP (192-239)
F00:5022       FN_SAVE3	equ	FN_SAVE2+48	; PRINT USING (1816-1859)
F00:5023       FN_XSIZE	equ	FN_SAVE3+44
F00:5024       K_PROC		equ	5		; the kind of a PROC definition ($40 + 5)
F00:5025       
F00:5026       ; DEF FNname[(param, ...)] = expression            one line
