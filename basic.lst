F00:5087       ; an FN/PROC call's frame on the stack: the parameters (laid out like variables), then
F00:5088       ; what the call has to put back
F00:5089       FN_TYPE		equ	FN_SIZE+0	; .w 1 FN, 2 PROC
F00:5090       FN_MULTI	equ	FN_SIZE+2	; .w a multi-line body
F00:5091       FN_LINE		equ	FN_SIZE+4	; the DEF's line
F00:5092       FN_SCURL	equ	FN_SIZE+8	; saved: D_CURLIN
F00:5093       FN_SSTMT	equ	FN_SIZE+12	; D_STMT
F00:5094       FN_SSP		equ	FN_SIZE+16	; D_STMTSP
F00:5095       FN_STMPB	equ	FN_SIZE+20	; D_TMPBASE
