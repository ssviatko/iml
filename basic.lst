F00:5014       ; ---------------------------------------------------------------- DEF FN, DEF PROC
F00:5015       
F00:5016       ; an FN/PROC call's frame on the stack: the parameters (laid out like variables), then
F00:5017       ; what the call has to put back
F00:5018       FN_TYPE		equ	FN_SIZE+0	; .w 1 FN, 2 PROC
F00:5019       FN_MULTI	equ	FN_SIZE+2	; .w a multi-line body
F00:5020       FN_LINE		equ	FN_SIZE+4	; the DEF's line
F00:5021       FN_SCURL	equ	FN_SIZE+8	; saved: D_CURLIN
F00:5022       FN_SSTMT	equ	FN_SIZE+12	; D_STMT
F00:5023       FN_SSP		equ	FN_SIZE+16	; D_STMTSP
