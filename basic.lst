F00:4771       ; Alois Zingl's ellipse in a rectangle. D6 = 1 to fill. The rectangle can be at most 512
F00:4772       ; pixels wide and high (to keep the arithmetic in 32 bits)
F00:4773       E_X0		equ	-4
F00:4774       E_Y0		equ	-8
F00:4775       E_X1		equ	-12
