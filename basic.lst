F00:0001       ; IML BASIC for the 68000 (see docs/basic68.md)
F00:0002       ;
F00:0003       ; Assemble with vasm (Motorola syntax):
F00:0004       ;   vasmm68k_mot -Fbin -m68000 -opt-brajmp -DBASE=<address> -o basic.bin basic.s
F00:0005       ; BASE is the next $1000 boundary above the end of the monitor; the Makefile works it out
F00:0006       ; from the size of mrom.bin, and m68k.c loads basic.bin there.
F00:0007       ;
F00:0008       ; Entry points: BASE+0 cold start (clears everything), BASE+4 warm start (keeps the program
F00:0009       ; and the variables). The monitor's B and W commands call them, and MONITOR (or BYE) goes
F00:0010       ; back to the monitor.
F00:0011       ;
F00:0012       ; Memory: everything BASIC keeps is between LOMEM and HIMEM (default $10000-$16ffff), so
F00:0013       ; that block can be saved with bsave and loaded back with bload:
F00:0014       ;   LOMEM            BASIC's internal variables, buffers and FOR/GOSUB/WHILE/REPEAT stack
F00:0015       ;   LOMEM+D_SIZE     the program, growing up
F00:0016       ;   after it         the string heap, growing up
F00:0017       ;   ...              free; temporary strings are made at the top of the free space
F00:0018       ;   HIMEM            the variable table, growing down from HIMEM
F00:0019       ; The long at $001000 holds LOMEM, so that the warm start can find it.
F00:0020       ;
F00:0021       ; Registers while BASIC runs: A5 = text pointer, A6 = LOMEM (the internal variables).
F00:0022       ; Every other register is scratch: a routine can change D0-D7/A0-A4 unless it says it doesn't.
F00:0023       
F00:0024       	ifnd BASE
F00:0025       BASE	equ	$1c3000
F00:0026       	endif
F00:0027       
F00:0028       ; ---------------------------------------------------------------- hardware
F00:0029       
F00:0030       IO		equ	$1bfc00
F00:0031       IO_KEYQ_SIZE	equ	IO+$00
F00:0032       IO_KEYQ_WAITING	equ	IO+$01
F00:0033       IO_KEYQ_DEQUEUE	equ	IO+$02
F00:0034       IO_CON_CLS	equ	IO+$10
F00:0035       IO_CON_COLOR	equ	IO+$11
F00:0036       IO_CON_CHAROUT	equ	IO+$12
F00:0037       IO_CON_REGISTER	equ	IO+$13
F00:0038       IO_CON_CURSORH	equ	IO+$14
F00:0039       IO_CON_CURSORV	equ	IO+$15
F00:0040       IO_VIDMODE	equ	IO+$20
F00:0041       IO_RANDBYTE	equ	IO+$21
F00:0042       
F00:0043       FP_INIT		equ	IO+$40		; FP commands: bit 6 = 0 FACC / 1 FARG, $20 = 80 bit
F00:0044       FP_MUL		equ	IO+$42
F00:0045       FP_DIV		equ	IO+$43
F00:0046       FP_ADD		equ	IO+$44
F00:0047       FP_SUB		equ	IO+$45
F00:0048       FP_LN		equ	IO+$46
F00:0049       FP_ILOAD	equ	IO+$47
F00:0050       FP_EXP		equ	IO+$49
F00:0051       FP_SIN		equ	IO+$4a
F00:0052       FP_COS		equ	IO+$4b
F00:0053       FP_TAN		equ	IO+$4c
F00:0054       FP_ATN		equ	IO+$4d
F00:0055       FP_POW		equ	IO+$4e
F00:0056       FP_CMP		equ	IO+$4f
F00:0057       FP_FROMA	equ	IO+$50
F00:0058       FP_TOA		equ	IO+$51
F00:0059       FP_FUNC		equ	IO+$52		; low bits: 0 log10 1 sqrt 2 abs 3 neg 4 floor 5 ceil 6 trunc 7 round 8 asin 9 acos
F00:0060       FP_CLASS	equ	IO+$53		; FPCOND: 1 zero, 2 negative, $10 NaN, $20 infinite
F00:0061       FP_ISAVEC	equ	IO+$54		; to FPINT, FPCOND $20 if out of range
F00:0062       FP_TOAF		equ	IO+$55		; fixed point text, low bits = decimals
F00:0063       FP_TOAE		equ	IO+$56		; exponent text
F00:0064       FPCOND		equ	$1bfcbf
F00:0065       FPASCII		equ	$1bfcc0
F00:0066       FPINT		equ	$1bfcd8
F00:0067       FPACC		equ	$1bfce0
F00:0068       FPARG		equ	$1bfcf0
F00:0069       X		equ	$20		; extended (80 bit) operation on FACC
F00:0070       XA		equ	$60		; extended operation on FARG
F00:0071       
F00:0072       BPTR		equ	$1000		; LOMEM of the BASIC in memory (for the warm start)
F00:0073       STACKTOP	equ	$10000		; the 68000 stack (shared with the monitor)
F00:0074       STKLIMIT	equ	$3000		; expressions nested deeper than this: FORMULA TOO COMPLEX
F00:0075       DEF_LOMEM	equ	$10000
F00:0076       DEF_HIMEM	equ	$16ffff
F00:0077       RAMTOP		equ	$180000		; video memory starts here
F00:0078       MAGIC		equ	'IMLE'		; (changes when the layout of the block does)
F00:0079       
F00:0080       ; ---------------------------------------------------------------- internal variables (at LOMEM, A6)
F00:0081       
F00:0082       D_MAGIC		equ	0
F00:0083       D_LOMEM		equ	4		; where this block was set up (checked by the warm start)
F00:0084       D_HIMEM		equ	8		; HIMEM as given (last usable byte)
F00:0085       D_MEMTOP	equ	12		; HIMEM+1, even: the variable table grows down from here
F00:0086       D_PRGEND	equ	16		; the zero word that ends the program
F00:0087       D_VARBOT	equ	20		; bottom of the variable table
F00:0088       D_STRBOT	equ	24		; string heap: start
F00:0089       D_STRTOP	equ	28		; string heap: next free byte
F00:0090       D_TMPPTR	equ	32		; temporary strings: grow down from VARBOT, reset every statement
F00:0091       D_GARBAGE	equ	36		; bytes of dead strings in the heap
F00:0092       D_CURLIN	equ	40		; line being run (D_DIRBUF for a direct command)
F00:0093       D_STMT		equ	44		; start of the statement being run
F00:0094       D_CSP		equ	48		; control stack pointer (grows down)
F00:0095       D_DATLIN	equ	52		; READ position: line,
F00:0096       D_DATPTR	equ	56		; and text pointer
F00:0097       D_CONTLIN	equ	60		; CONT: line,
F00:0098       D_CONTPTR	equ	64		; and text pointer (0 = can't continue)
F00:0099       D_GCROOT	equ	68		; garbage collection: one more string pointer to update
F00:0100       D_FORVAR	equ	72		; FOR: variable address
F00:0101       D_INSAVE	equ	76		; INPUT: start of the statement, to redo it
F00:0102       D_SWDEFP	equ	80		; SWITCH: DEFAULT text pointer (0 = none),
F00:0103       D_SWDEFL	equ	84		; and line
F00:0104       D_SLIF		equ	88		; .b running the THEN part of a one line IF
F00:0105       D_TRACE		equ	89		; .b TRON
F00:0106       D_DATIN		equ	90		; .b READ: 0 = find a DATA statement, 1 = at its first item, 2 = after an item
F00:0107       D_FORKIND	equ	92		; .w FOR: variable kind
F00:0108       D_NAMELEN	equ	94		; .w name just parsed
F00:0109       D_NAME		equ	96		; 32 bytes
F00:0110       D_VA		equ	128		; value accumulator (16 bytes)
F00:0111       D_VB		equ	144		; left operand
F00:0112       D_VC		equ	160		; scratch value
F00:0113       D_VZERO		equ	176		; 16 zero bytes: the value of a missing array element
F00:0114       D_SWVAL		equ	192		; SWITCH value
F00:0115       D_FORLIM	equ	208		; FOR limit
F00:0116       D_FORSTEP	equ	224		; FOR step
F00:0117       D_WORK		equ	240		; 8 bytes
F00:0118       D_NUMBUF	equ	256		; 64 bytes: number to text
F00:0119       D_SCRATCH	equ	320		; 64 bytes: text to number
F00:0120       D_WORD		equ	384		; 64 bytes: keyword being crunched
F00:0121       D_GARG		equ	448		; 8 longs: graphics statement arguments
F00:0122       D_GCNT		equ	480		; .w how many
F00:0123       D_GRCOLOR	equ	482		; .w GRCOLOR
F00:0124       D_GW		equ	484		; .w screen width in pixels
F00:0125       D_GH		equ	486		; .w height
F00:0126       D_GROW		equ	488		; .w bytes per row
F00:0127       D_GDEEP		equ	490		; .b 1 = 4096 colors (2 bytes per pixel)
F00:0128       D_INBUF		equ	512		; 256 bytes: input line
F00:0129       D_ONERR		equ	1800		; ON ERROR GOTO line
F00:0130       D_ERRLIN	equ	1804		; the line (pointer) of the last trapped error
F00:0131       D_ERRSTMT	equ	1808		; and its statement
F00:0132       D_FNFRAME	equ	1812		; the innermost FN call's parameters (0 = none)
F00:0133       D_UFMT		equ	1816		; PRINT USING: the format,
F00:0134       D_UFLEN		equ	1820		; its length,
F00:0135       D_UPOS		equ	1824		; where we are in it
F00:0136       D_ERRNUM	equ	1828		; ERR
F00:0137       D_ERRLINE	equ	1832		; ERL
F00:0138       D_ERRCODE	equ	1836		; .w the error (our number)
F00:0139       D_ONERRF	equ	1838		; .b ON ERROR is set
F00:0140       D_INERR		equ	1839		; .b running an error handler
F00:0141       D_UNL		equ	1840		; .b PRINT USING: no new line at the end
F00:0142       D_UTYPE		equ	1841		; .b field: 1 number, 2 !, 3 \ \, 4 &
F00:0143       D_UBEF		equ	1842		; .w positions before the point
F00:0144       D_UDIG		equ	1844		; .w # positions before the point
F00:0145       D_UDEC		equ	1846		; .w digits after the point
F00:0146       D_UPT		equ	1848		; .b there is a point
F00:0147       D_UCOMMA	equ	1849		; .b commas
F00:0148       D_UPLUS		equ	1850		; .b leading +
F00:0149       D_UTRAIL	equ	1851		; .b trailing sign: 1 -, 2 +
F00:0150       D_USTAR		equ	1852		; .b ** fill
F00:0151       D_UDOLLAR	equ	1853		; .b $
F00:0152       D_UEXP		equ	1854		; .b ^^^^
F00:0153       D_UWID		equ	1856		; .w \ \ width
F00:0154       D_RNEW		equ	1860		; RENUM: new first number,
F00:0155       D_RFROM		equ	1864		; from this old line,
F00:0156       D_RSTEP		equ	1868		; step
F00:0157       D_LBLCNT	equ	1872		; .w labels in the cache
F00:0158       D_LBLOK		equ	1874		; .b 0 = no cache, 1 = all labels in it, 2 = too many for it
F00:0159       D_CRUNCH	equ	768		; 512 bytes: crunched program line
F00:0160       D_DIRBUF	equ	1280		; a direct command as a line: length, $ffff, text, then a zero word
F00:0161       D_CSTBOT	equ	2048		; control stack
F00:0162       D_CSTTOP	equ	10240
F00:0163       D_LBLTAB	equ	10240		; label cache: LBLMAX entries of LB_SIZE
F00:0164       D_SIZE		equ	16384		; the program starts here
F00:0165       
F00:0166       ; label cache entries (built when a label is first looked up, dropped when the program
F00:0167       ; or the variables are cleared)
F00:0168       LB_NAME		equ	0		; the name, in the program text (after the *)
F00:0169       LB_LINE		equ	4		; the line it starts
F00:0170       LB_HASH		equ	8		; .w
F00:0171       LB_LEN		equ	10		; .w
F00:0172       LB_SIZE		equ	12
F00:0173       LBLMAX		equ	(D_SIZE-D_LBLTAB)/LB_SIZE
F00:0174       
F00:0175       MAXLINE		equ	500		; crunched line length limit
F00:0176       
F00:0177       ; an FN call's parameters, on the stack: entries are laid out like variables
F00:0178       FN_PREV		equ	0		; the call outside this one
F00:0179       FN_CNT		equ	4		; .w parameters
F00:0180       FN_KIND		equ	6		; .w the function's kind
F00:0181       FN_CALLER	equ	8		; the caller's text pointer
F00:0182       FN_EXPR		equ	12		; the definition's expression
F00:0183       FN_ENT		equ	16
F00:0184       FN_ESIZE	equ	56		; size.l, kind.b, namelen.b, name (32), data (16)
F00:0185       FN_MAX		equ	8
F00:0186       FN_SIZE		equ	FN_ENT+FN_MAX*FN_ESIZE
F00:0187       
F00:0188       ; a program line: length.w (whole line, even), number.l, the crunched text, a zero
F00:0189       LNUM		equ	2		; offset of the line number
F00:0190       LH		equ	6		; offset of the text
F00:0191       DIRECT		equ	$ffffffff	; the line number of a direct command
F00:0192       
F00:0193       ; values: a 16 byte block. +0 type.w, +4 data: int64 (hi.l, lo.l), 80 bit float (Intel
F00:0194       ; byte order, 10 bytes), or string (pointer.l, length.l)
F00:0195       T_INT		equ	1
F00:0196       T_FLT		equ	2
F00:0197       T_STR		equ	3
F00:0198       
F00:0199       ; variable kinds (the suffix): %, &, none, $. Bit 7 set = array
F00:0200       K_INT		equ	1		; 32 bit integer (4 bytes)
F00:0201       K_LONG		equ	2		; 64 bit integer (8 bytes)
F00:0202       K_FLT		equ	3		; 80 bit float (10 bytes)
F00:0203       K_STR		equ	4		; string descriptor: pointer.l, length.l (8 bytes)
F00:0204       
F00:0205       ; variable table entry: size.l, kind.b, namelen.b, name (padded to even), data
F00:0206       ; array data: ndims.w, count.l * ndims, elements
F00:0207       ; string heap block: owner.l (the descriptor), length.l, the characters (padded to even)
F00:0208       
F00:0209       ; control stack frames
F00:0210       FRAME		equ	52
F00:0211       F_FOR		equ	1
F00:0212       F_GOSUB		equ	2
F00:0213       F_WHILE		equ	3
F00:0214       F_REPEAT	equ	4
F00:0215       FR_TYPE		equ	0		; .w
F00:0216       FR_KIND		equ	2		; .w FOR: variable kind
F00:0217       FR_VAR		equ	4		; FOR: variable address
F00:0218       FR_LINE		equ	8
F00:0219       FR_TEXT		equ	12
F00:0220       FR_LIMIT	equ	16		; FOR: limit value (16)
F00:0221       FR_STEP		equ	32		; FOR: step value (16)
F00:0222       FR_SLIF		equ	48		; .b
F00:0223       
F00:0224       ; operators for binop
F00:0225       OP_ADD		equ	1
F00:0226       OP_SUB		equ	2
F00:0227       OP_MUL		equ	3
F00:0228       OP_DIV		equ	4
F00:0229       OP_IDIV		equ	5
F00:0230       OP_MOD		equ	6
F00:0231       OP_POW		equ	7
F00:0232       OP_AND		equ	8
F00:0233       OP_OR		equ	9
F00:0234       OP_XOR		equ	10
F00:0235       OP_REL		equ	16		; relational: OP_REL + mask of 1 = equal, 2 = less, 4 = greater
F00:0236       OP_EQ		equ	OP_REL+1
F00:0237       OP_LT		equ	OP_REL+2
F00:0238       OP_LE		equ	OP_REL+3
F00:0239       OP_GT		equ	OP_REL+4
F00:0240       OP_GE		equ	OP_REL+5
F00:0241       OP_NE		equ	OP_REL+6
F00:0242       
F00:0243       ; error numbers (index into errmsgs)
F00:0244       E_SN		equ	0		; syntax
F00:0245       E_OM		equ	1		; out of memory
F00:0246       E_US		equ	2		; undefined statement (line)
F00:0247       E_TM		equ	3		; type mismatch
F00:0248       E_OV		equ	4		; overflow
F00:0249       E_DZ		equ	5		; division by zero
F00:0250       E_FC		equ	6		; illegal function call
F00:0251       E_NF		equ	7		; NEXT without FOR
F00:0252       E_RG		equ	8		; RETURN without GOSUB
F00:0253       E_OD		equ	9		; out of data
F00:0254       E_BS		equ	10		; bad subscript
F00:0255       E_DD		equ	11		; redimensioned array
F00:0256       E_LS		equ	12		; string too long
F00:0257       E_CN		equ	13		; can't continue
F00:0258       E_ST		equ	14		; formula too complex
F00:0259       E_WW		equ	15		; WEND without WHILE
F00:0260       E_UR		equ	16		; UNTIL without REPEAT
F00:0261       E_WH		equ	17		; WHILE without WEND
F00:0262       E_IF		equ	18		; IF without ENDIF
F00:0263       E_SW		equ	19		; SWITCH without ENDSWITCH
F00:0264       E_LL		equ	20		; line too long
F00:0265       E_UF		equ	21		; undefined function
F00:0266       E_RW		equ	22		; RESUME without error
F00:0267       E_UP		equ	23		; unprintable error (ERROR n with a number BASIC doesn't use)
F00:0268       E_ID		equ	24		; illegal direct
F00:0269       E_UL		equ	25		; undefined label
F00:0270       E_AN		equ	26		; array not dimensioned
F00:0271       
F00:0272       ; ---------------------------------------------------------------- tokens
F00:0273       
F00:0274       TK_END		equ	$80		; statements, in the order of stmttab
F00:0275       TK_FOR		equ	$81
F00:0276       TK_NEXT		equ	$82
F00:0277       TK_DATA		equ	$83
F00:0278       TK_INPUT	equ	$84
F00:0279       TK_DIM		equ	$85
F00:0280       TK_READ		equ	$86
F00:0281       TK_LET		equ	$87
F00:0282       TK_GOTO		equ	$88
F00:0283       TK_RUN		equ	$89
F00:0284       TK_IF		equ	$8a
F00:0285       TK_RESTORE	equ	$8b
F00:0286       TK_GOSUB	equ	$8c
F00:0287       TK_RETURN	equ	$8d
F00:0288       TK_REM		equ	$8e
F00:0289       TK_STOP		equ	$8f
F00:0290       TK_ON		equ	$90
F00:0291       TK_POKE		equ	$91
F00:0292       TK_PRINT	equ	$92
F00:0293       TK_CONT		equ	$93
F00:0294       TK_LIST		equ	$94
F00:0295       TK_CLEAR	equ	$95
F00:0296       TK_NEW		equ	$96
F00:0297       TK_CLS		equ	$97
F00:0298       TK_LOCATE	equ	$98
F00:0299       TK_COLOR	equ	$99
F00:0300       TK_WHILE	equ	$9a
F00:0301       TK_WEND		equ	$9b
F00:0302       TK_REPEAT	equ	$9c
F00:0303       TK_UNTIL	equ	$9d
F00:0304       TK_SWITCH	equ	$9e
F00:0305       TK_CASE		equ	$9f
F00:0306       TK_DEFAULT	equ	$a0
F00:0307       TK_ENDSWITCH	equ	$a1
F00:0308       TK_ELSE		equ	$a2
F00:0309       TK_ENDIF	equ	$a3
F00:0310       TK_CALL		equ	$a4
F00:0311       TK_MONITOR	equ	$a5
F00:0312       TK_BYE		equ	$a6
F00:0313       TK_DELETE	equ	$a7
F00:0314       TK_RANDOMIZE	equ	$a8
F00:0315       TK_TRON		equ	$a9
F00:0316       TK_TROFF	equ	$aa
F00:0317       TK_LINE		equ	$ab
F00:0318       TK_APOS		equ	$ac		; ' (a REM)
F00:0319       TK_LOMEM	equ	$ad
F00:0320       TK_HIMEM	equ	$ae
F00:0321       TK_GR		equ	$af
F00:0322       TK_TEXT		equ	$b0
F00:0323       TK_GRCLS	equ	$b1
F00:0324       TK_PLOT		equ	$b2
F00:0325       TK_GRCOLOR	equ	$b3
F00:0326       TK_RECTANGLE	equ	$b4
F00:0327       TK_CIRCLE	equ	$b5
F00:0328       TK_FILLRECT	equ	$b6
F00:0329       TK_FILLCIRCLE	equ	$b7
F00:0330       TK_DEF		equ	$b8
F00:0331       TK_SWAP		equ	$b9
F00:0332       TK_RENUM	equ	$ba
F00:0333       TK_RESUME	equ	$bb
F00:0334       TK_ERROR	equ	$bc
F00:0335       TK_ELSEIF	equ	$bd
F00:0336       TK_LABELS	equ	$be
F00:0337       TK_ARRAYS	equ	$bf
F00:0338       TK_LASTST	equ	$bf		; last statement token
F00:0339       TK_THEN		equ	$c0		; other keywords
F00:0340       TK_TO		equ	$c1
F00:0341       TK_STEP		equ	$c2
F00:0342       TK_AND		equ	$c3
F00:0343       TK_OR		equ	$c4
F00:0344       TK_XOR		equ	$c5
F00:0345       TK_NOT		equ	$c6
F00:0346       TK_MOD		equ	$c7
F00:0347       TK_TAB		equ	$c8
F00:0348       TK_SPC		equ	$c9
F00:0349       TK_USING	equ	$ca
F00:0350       TK_FN		equ	$cb
F00:0351       TK_FIRSTFN	equ	$cc		; functions, in the order of fntab
F00:0352       TK_MID		equ	TK_FIRSTFN+27
F00:0353       TK_LASTFN	equ	$f3
F00:0354       
F00:0355       ; ---------------------------------------------------------------- macros
F00:0356       
F00:0357       	macro ERROR
F00:0360       
F00:0361       
F00:0362       ; print the string that follows (zero terminated). keeps all registers
F00:0363       	macro PRINTS
F00:0367       
F00:0368       
F00:0369       ; ---------------------------------------------------------------- entry
F00:0370       
F00:0371       	org BASE
F00:0372       
F00:0373       	bra.w cold
               S01:001C3000:  60 00 00 14
F00:0374       	bra.w warm
               S01:001C3004:  60 00 00 32
F00:0375       	dc.b "IMLBASIC"			; the monitor and m68k.c look for this
               S01:001C3008:  49 4D 4C 42 41 53 49 43
F00:0376       	dc.l BASE			; where this was assembled for
               S01:001C3010:  00 1C 30 00
F00:0377       	dc.w $0100			; version 1.0
               S01:001C3014:  01 00
F00:0378       
F00:0379       cold:
F00:0380       	lea STACKTOP,sp
               S01:001C3016:  4F F9 00 01 00 00
F00:0381       	move.l #DEF_LOMEM,a6
               S01:001C301C:  2C 7C 00 01 00 00
F00:0382       	move.l #DEF_HIMEM,d0
               S01:001C3022:  20 3C 00 16 FF FF
F00:0383       	bsr setup
               S01:001C3028:  61 00 00 E6
F00:0384       	bsr do_new
